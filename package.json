{
  "name": "obs-auto-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.live.test.ts'",
    "test:live": "vitest run .live.test.ts",
    "reading": "tsx agents/reading/src/cli.ts",
    "coverage:spec": "tsx agents/reading/evals/check-coverage.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@octokit/auth-app": "8.3.1",
    "@octokit/rest": "22.0.1",
    "@sinclair/typebox": "0.34.52",
    "ajv": "8.20.0",
    "ali-oss": "6.23.0",
    "cheerio": "1.2.0",
    "playwright": "1.64.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/ali-oss": "6.23.3",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
