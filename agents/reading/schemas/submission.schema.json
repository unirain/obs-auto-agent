{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "submission_id",
    "execution_scope",
    "submitted_by",
    "submitted_at",
    "input_hash",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "number"
    },
    "submission_id": {
      "minLength": 1,
      "type": "string"
    },
    "execution_scope": {
      "const": "production",
      "type": "string"
    },
    "submitted_by": {
      "minLength": 1,
      "type": "string"
    },
    "submitted_at": {
      "pattern": "^(?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,3})?Z(?![\\s\\S])",
      "type": "string"
    },
    "input_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url",
          "status",
          "candidate_id",
          "reason_codes",
          "candidate_status",
          "project_id",
          "pr_number"
        ],
        "properties": {
          "url": {
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "anyOf": [
              {
                "const": "queued",
                "type": "string"
              },
              {
                "const": "already_known",
                "type": "string"
              },
              {
                "const": "rejected",
                "type": "string"
              }
            ]
          },
          "candidate_id": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "minLength": 1,
              "type": "string"
            }
          },
          "candidate_status": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "project_id": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "pr_number": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
