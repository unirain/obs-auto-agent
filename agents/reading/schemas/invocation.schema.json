{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "invocation_id",
    "execution_scope",
    "subject_id",
    "capability",
    "input_hash",
    "context_hash",
    "policy_hash",
    "model",
    "sdk_version",
    "status",
    "messages",
    "usage",
    "limits"
  ],
  "properties": {
    "request_started": {
      "type": "boolean"
    },
    "schema_version": {
      "const": 1,
      "type": "number"
    },
    "invocation_id": {
      "type": "string"
    },
    "execution_scope": {
      "anyOf": [
        {
          "const": "production",
          "type": "string"
        },
        {
          "const": "preview",
          "type": "string"
        }
      ]
    },
    "subject_id": {
      "type": "string"
    },
    "capability": {
      "type": "string"
    },
    "input_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "context_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "policy_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "sdk_version": {
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "const": "prepared",
          "type": "string"
        },
        {
          "const": "running",
          "type": "string"
        },
        {
          "const": "succeeded",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        },
        {
          "const": "unknown",
          "type": "string"
        }
      ]
    },
    "messages": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": ["message_id", "usage", "summary"],
        "properties": {
          "message_id": {
            "type": "string"
          },
          "usage": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "input_tokens",
              "output_tokens",
              "cost_usd",
              "cost_status"
            ],
            "properties": {
              "input_tokens": {
                "minimum": 0,
                "type": "integer"
              },
              "output_tokens": {
                "minimum": 0,
                "type": "integer"
              },
              "cost_usd": {
                "anyOf": [
                  {
                    "minimum": 0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cost_status": {
                "anyOf": [
                  {
                    "const": "known",
                    "type": "string"
                  },
                  {
                    "const": "unknown",
                    "type": "string"
                  }
                ]
              }
            }
          },
          "summary": {
            "type": "boolean"
          }
        }
      }
    },
    "usage": {
      "additionalProperties": false,
      "type": "object",
      "required": ["input_tokens", "output_tokens", "cost_usd", "cost_status"],
      "properties": {
        "input_tokens": {
          "minimum": 0,
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "type": "integer"
        },
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "cost_status": {
          "anyOf": [
            {
              "const": "known",
              "type": "string"
            },
            {
              "const": "unknown",
              "type": "string"
            }
          ]
        }
      }
    },
    "limits": {}
  }
}
