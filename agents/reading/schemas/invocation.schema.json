{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "invocation_id",
    "execution_scope",
    "subject_id",
    "capability",
    "input_hash",
    "context_hash",
    "policy_hash",
    "model",
    "sdk_version",
    "status",
    "messages",
    "usage",
    "limits"
  ],
  "properties": {
    "request_started": {
      "type": "boolean"
    },
    "schema_version": {
      "const": 1,
      "type": "number"
    },
    "invocation_id": {
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9_-]+$",
      "type": "string"
    },
    "execution_scope": {
      "anyOf": [
        {
          "const": "production",
          "type": "string"
        },
        {
          "const": "preview",
          "type": "string"
        }
      ]
    },
    "subject_id": {
      "type": "string"
    },
    "capability": {
      "type": "string"
    },
    "input_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "context_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "policy_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "sdk_version": {
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "const": "prepared",
          "type": "string"
        },
        {
          "const": "running",
          "type": "string"
        },
        {
          "const": "succeeded",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        },
        {
          "const": "unknown",
          "type": "string"
        }
      ]
    },
    "messages": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message_id",
          "usage",
          "summary"
        ],
        "properties": {
          "message_id": {
            "minLength": 1,
            "type": "string"
          },
          "usage": {
            "anyOf": [
              {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "input_tokens",
                  "output_tokens",
                  "cost_usd",
                  "cost_status"
                ],
                "properties": {
                  "input_tokens": {
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer"
                  },
                  "output_tokens": {
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer"
                  },
                  "cost_usd": {
                    "minimum": 0,
                    "type": "number"
                  },
                  "cost_status": {
                    "const": "known",
                    "type": "string"
                  }
                }
              },
              {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "input_tokens",
                  "output_tokens",
                  "cost_usd",
                  "cost_status"
                ],
                "properties": {
                  "input_tokens": {
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer"
                  },
                  "output_tokens": {
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer"
                  },
                  "cost_usd": {
                    "type": "null"
                  },
                  "cost_status": {
                    "const": "unknown",
                    "type": "string"
                  }
                }
              }
            ]
          },
          "summary": {
            "type": "boolean"
          }
        }
      }
    },
    "usage": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "input_tokens",
            "output_tokens",
            "cost_usd",
            "cost_status"
          ],
          "properties": {
            "input_tokens": {
              "minimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "output_tokens": {
              "minimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "cost_usd": {
              "minimum": 0,
              "type": "number"
            },
            "cost_status": {
              "const": "known",
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "input_tokens",
            "output_tokens",
            "cost_usd",
            "cost_status"
          ],
          "properties": {
            "input_tokens": {
              "minimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "output_tokens": {
              "minimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "cost_usd": {
              "type": "null"
            },
            "cost_status": {
              "const": "unknown",
              "type": "string"
            }
          }
        }
      ]
    },
    "limits": {}
  }
}
