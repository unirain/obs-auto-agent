{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "sequence",
    "workspace_id",
    "execution_scope",
    "revision",
    "manifest_key",
    "manifest_sha256",
    "parent_commit_key",
    "parent_commit_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "number"
    },
    "sequence": {
      "pattern": "^[0-9]{20}$",
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "execution_scope": {
      "anyOf": [
        {
          "const": "production",
          "type": "string"
        },
        {
          "const": "preview",
          "type": "string"
        }
      ]
    },
    "revision": {
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9_-]+$",
      "type": "string"
    },
    "manifest_key": {
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "parent_commit_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "parent_commit_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
