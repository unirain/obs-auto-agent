{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "key",
    "workspace_id",
    "source_id",
    "reason_code",
    "last_position",
    "status",
    "suppressed",
    "unresolved_gaps",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "number"
    },
    "key": {
      "minLength": 1,
      "type": "string"
    },
    "workspace_id": {
      "minLength": 1,
      "type": "string"
    },
    "source_id": {
      "minLength": 1,
      "type": "string"
    },
    "reason_code": {
      "minLength": 1,
      "type": "string"
    },
    "last_position": {
      "minimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "status": {
      "anyOf": [
        {
          "const": "active",
          "type": "string"
        },
        {
          "const": "recovered",
          "type": "string"
        },
        {
          "const": "accepted_gap",
          "type": "string"
        }
      ]
    },
    "suppressed": {
      "type": "boolean"
    },
    "unresolved_gaps": {
      "type": "array",
      "items": {
        "minLength": 1,
        "type": "string"
      }
    },
    "event_summary": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "total",
        "first_at",
        "last_at"
      ],
      "properties": {
        "total": {
          "minimum": 1,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "first_at": {
          "pattern": "^(?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,3})?Z(?![\\s\\S])",
          "type": "string"
        },
        "last_at": {
          "pattern": "^(?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,3})?Z(?![\\s\\S])",
          "type": "string"
        }
      }
    },
    "events": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "position",
          "kind",
          "occurred_at"
        ],
        "properties": {
          "event_id": {
            "minLength": 1,
            "type": "string"
          },
          "position": {
            "minimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "kind": {
            "anyOf": [
              {
                "const": "occurred",
                "type": "string"
              },
              {
                "const": "recovered",
                "type": "string"
              },
              {
                "const": "coverage_gap",
                "type": "string"
              },
              {
                "const": "accepted_gap",
                "type": "string"
              },
              {
                "const": "gap_resolved",
                "type": "string"
              }
            ]
          },
          "occurred_at": {
            "pattern": "^(?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,3})?Z(?![\\s\\S])",
            "type": "string"
          }
        }
      }
    }
  }
}
