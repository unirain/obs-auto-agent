{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "reading/monitor-metadata",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "key": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "reason_code": {
      "type": "string"
    },
    "last_position": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "active",
        "recovered",
        "accepted_gap"
      ]
    },
    "suppressed": {
      "type": "boolean"
    },
    "unresolved_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string"
          },
          "position": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "type": "string"
          },
          "occurred_at": {
            "type": "string"
          }
        },
        "required": [
          "event_id",
          "position",
          "kind",
          "occurred_at"
        ],
        "additionalProperties": false
      }
    },
    "event_summary": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 1
        },
        "first_at": {
          "type": "string"
        },
        "last_at": {
          "type": "string"
        }
      },
      "required": [
        "total",
        "first_at",
        "last_at"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "key",
    "workspace_id",
    "source_id",
    "reason_code",
    "last_position",
    "status",
    "suppressed",
    "unresolved_gaps",
    "events"
  ],
  "additionalProperties": false
}
