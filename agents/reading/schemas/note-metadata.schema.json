{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "path",
    "commit",
    "title",
    "tags",
    "sources",
    "summary",
    "organized_at",
    "date_basis",
    "hash",
    "pending"
  ],
  "properties": {
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "path": {
      "minLength": 1,
      "type": "string"
    },
    "commit": {
      "pattern": "^[a-f0-9]{40}$",
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "organized_at": {
      "pattern": "^(?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,3})?Z(?![\\s\\S])",
      "type": "string"
    },
    "date_basis": {
      "minLength": 1,
      "type": "string"
    },
    "hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "pending": {
      "type": "boolean"
    },
    "retrieval_relevance": {
      "anyOf": [
        {
          "const": "matched",
          "type": "string"
        },
        {
          "const": "unknown",
          "type": "string"
        }
      ]
    }
  }
}
