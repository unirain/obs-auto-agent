{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "object_key",
    "sha256",
    "bytes",
    "mime",
    "url",
    "project_id",
    "version_id",
    "confirmed_at"
  ],
  "properties": {
    "object_key": {
      "type": "string"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "bytes": {
      "minimum": 1,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "mime": {
      "anyOf": [
        {
          "const": "image/png",
          "type": "string"
        },
        {
          "const": "image/jpeg",
          "type": "string"
        },
        {
          "const": "image/webp",
          "type": "string"
        },
        {
          "const": "image/svg+xml",
          "type": "string"
        }
      ]
    },
    "url": {
      "pattern": "^https://",
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "version_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "confirmed_at": {
      "pattern": "^(?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,3})?Z(?![\\s\\S])",
      "type": "string"
    }
  }
}
