{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "candidate_id",
    "source_id",
    "source_item_id",
    "origin_source_ids",
    "url",
    "canonical_url",
    "aliases",
    "title",
    "discovered_at",
    "published_at",
    "submission_refs",
    "content_hash",
    "status",
    "project_id",
    "pr_number"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "number"
    },
    "candidate_id": {
      "minLength": 1,
      "type": "string"
    },
    "source_id": {
      "minLength": 1,
      "type": "string"
    },
    "source_item_id": {
      "minLength": 1,
      "type": "string"
    },
    "origin_source_ids": {
      "type": "array",
      "items": {
        "minLength": 1,
        "type": "string"
      }
    },
    "url": {
      "minLength": 1,
      "type": "string"
    },
    "canonical_url": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "aliases": {
      "type": "array",
      "items": {
        "minLength": 1,
        "type": "string"
      }
    },
    "title": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "discovered_at": {
      "minLength": 1,
      "type": "string"
    },
    "published_at": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "submission_refs": {
      "type": "array",
      "items": {
        "minLength": 1,
        "type": "string"
      }
    },
    "content_hash": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "minLength": 1,
      "type": "string"
    },
    "project_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "pr_number": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
