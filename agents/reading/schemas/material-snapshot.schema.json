{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "url",
    "text",
    "hash",
    "retrieved_at",
    "links",
    "kind"
  ],
  "properties": {
    "url": {
      "minLength": 1,
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "retrieved_at": {
      "pattern": "^(?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,3})?Z(?![\\s\\S])",
      "type": "string"
    },
    "links": {
      "type": "array",
      "items": {
        "minLength": 1,
        "type": "string"
      }
    },
    "kind": {
      "anyOf": [
        {
          "const": "web",
          "type": "string"
        },
        {
          "const": "pdf",
          "type": "string"
        },
        {
          "const": "code",
          "type": "string"
        }
      ]
    },
    "capture_method": {
      "anyOf": [
        {
          "const": "http",
          "type": "string"
        },
        {
          "const": "browser",
          "type": "string"
        }
      ]
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commit": {
      "minLength": 1,
      "type": "string"
    },
    "file": {
      "minLength": 1,
      "type": "string"
    },
    "requested_url": {
      "minLength": 1,
      "type": "string"
    },
    "figures": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url",
          "caption"
        ],
        "properties": {
          "url": {
            "minLength": 1,
            "type": "string"
          },
          "caption": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    },
    "canonical_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": "string"
    },
    "link_locators": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url",
          "page"
        ],
        "properties": {
          "url": {
            "minLength": 1,
            "type": "string"
          },
          "page": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "body_metadata": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "line_count",
        "page_count"
      ],
      "properties": {
        "line_count": {
          "minimum": 1,
          "type": "integer"
        },
        "page_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "body_reference": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "schema_version": {
          "const": 1,
          "type": "number"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "bytes": {
          "minimum": 0,
          "type": "integer"
        }
      }
    }
  }
}
