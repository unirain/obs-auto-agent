{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "delivery_id",
    "execution_scope",
    "workspace_id",
    "project_id",
    "generation_version",
    "workspace_revision",
    "context_id",
    "base_commit",
    "sources_verified_at",
    "files",
    "resources",
    "sources",
    "quality_report",
    "rationale",
    "knowledge_increment",
    "gaps",
    "image_degradations",
    "usage",
    "warnings",
    "validated_hash"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "number"
    },
    "delivery_id": {
      "type": "string"
    },
    "execution_scope": {
      "const": "production",
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "generation_version": {
      "minimum": 1,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "workspace_revision": {
      "minLength": 1,
      "type": "string"
    },
    "context_id": {
      "type": "string"
    },
    "base_commit": {
      "pattern": "^[a-f0-9]{40}$",
      "type": "string"
    },
    "sources_verified_at": {
      "pattern": "^(?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,3})?Z(?![\\s\\S])",
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "path",
          "role",
          "mime",
          "bytes",
          "sha256",
          "content_base64"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "role": {
            "anyOf": [
              {
                "const": "note",
                "type": "string"
              },
              {
                "const": "diagram_source",
                "type": "string"
              }
            ]
          },
          "mime": {
            "type": "string"
          },
          "bytes": {
            "minimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "content_base64": {
            "type": "string"
          },
          "symlink": {
            "const": false,
            "type": "boolean"
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "object_key",
          "sha256",
          "bytes",
          "mime",
          "url",
          "project_id",
          "version_id",
          "confirmed_at"
        ],
        "properties": {
          "object_key": {
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "bytes": {
            "minimum": 1,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "mime": {
            "anyOf": [
              {
                "const": "image/png",
                "type": "string"
              },
              {
                "const": "image/jpeg",
                "type": "string"
              },
              {
                "const": "image/webp",
                "type": "string"
              },
              {
                "const": "image/svg+xml",
                "type": "string"
              }
            ]
          },
          "url": {
            "pattern": "^https://",
            "type": "string"
          },
          "project_id": {
            "type": "string"
          },
          "version_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "confirmed_at": {
            "pattern": "^(?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,3})?Z(?![\\s\\S])",
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "primary_source_aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quality_report": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {}
      }
    },
    "rationale": {
      "type": "string"
    },
    "knowledge_increment": {
      "type": "string"
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "image_degradations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "usage": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "status",
        "estimated_usd"
      ],
      "properties": {
        "status": {
          "anyOf": [
            {
              "const": "known",
              "type": "string"
            },
            {
              "const": "unknown",
              "type": "string"
            },
            {
              "const": "partial",
              "type": "string"
            }
          ]
        },
        "estimated_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validated_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  }
}
