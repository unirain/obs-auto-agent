{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "evidence_id",
    "source_url",
    "retrieved_at",
    "snapshot_hash",
    "locator",
    "excerpt",
    "claim",
    "claim_type",
    "limits",
    "based_on"
  ],
  "properties": {
    "evidence_id": {
      "minLength": 1,
      "type": "string"
    },
    "source_url": {
      "minLength": 1,
      "type": "string"
    },
    "retrieved_at": {
      "pattern": "^(?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,3})?Z(?![\\s\\S])",
      "type": "string"
    },
    "snapshot_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "locator": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "start_line",
        "end_line"
      ],
      "properties": {
        "start_line": {
          "minimum": 1,
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "type": "integer"
        },
        "page": {
          "minimum": 1,
          "type": "integer"
        },
        "section": {
          "minLength": 1,
          "type": "string"
        },
        "commit": {
          "pattern": "^[a-f0-9]{40}$",
          "type": "string"
        },
        "file": {
          "minLength": 1,
          "type": "string"
        }
      }
    },
    "excerpt": {
      "minLength": 1,
      "type": "string"
    },
    "claim": {
      "minLength": 1,
      "type": "string"
    },
    "claim_type": {
      "anyOf": [
        {
          "const": "source_statement",
          "type": "string"
        },
        {
          "const": "code_observation",
          "type": "string"
        },
        {
          "const": "experiment_report",
          "type": "string"
        },
        {
          "const": "agent_inference",
          "type": "string"
        }
      ]
    },
    "limits": {
      "type": "array",
      "items": {
        "minLength": 1,
        "type": "string"
      }
    },
    "based_on": {
      "type": "array",
      "items": {
        "minLength": 1,
        "type": "string"
      }
    }
  }
}
