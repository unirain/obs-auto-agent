{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "delivery_id",
    "actor",
    "recorded_at",
    "reason",
    "review_minutes",
    "origin"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "number"
    },
    "delivery_id": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "recorded_at": {
      "pattern": "^(?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,3})?Z(?![\\s\\S])",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "anyOf": [
            {
              "const": "topic_irrelevant",
              "type": "string"
            },
            {
              "const": "duplicate",
              "type": "string"
            },
            {
              "const": "too_shallow",
              "type": "string"
            },
            {
              "const": "incorrect_fact",
              "type": "string"
            },
            {
              "const": "missing_source",
              "type": "string"
            },
            {
              "const": "image_or_text_quality",
              "type": "string"
            },
            {
              "const": "more_like_this",
              "type": "string"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "review_minutes": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "origin": {
      "const": "trusted_management",
      "type": "string"
    },
    "pr_binding": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "repository",
        "number",
        "url",
        "head_sha",
        "state",
        "checked_at"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "number": {
          "minimum": 1,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "url": {
          "type": "string"
        },
        "head_sha": {
          "pattern": "^[a-f0-9]{40}$",
          "type": "string"
        },
        "state": {
          "anyOf": [
            {
              "const": "open",
              "type": "string"
            },
            {
              "const": "merged",
              "type": "string"
            },
            {
              "const": "closed_unmerged",
              "type": "string"
            }
          ]
        },
        "checked_at": {
          "pattern": "^(?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,3})?Z(?![\\s\\S])",
          "type": "string"
        }
      }
    }
  }
}
