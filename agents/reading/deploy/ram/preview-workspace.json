{
  "Version": "1",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "oss:GetBucketAcl",
        "oss:GetBucketVersioning",
        "oss:GetBucketLifecycle",
        "oss:GetBucketPolicy"
      ],
      "Resource": [
        "acs:oss:*:*:obs-agent"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "oss:ListObjects"
      ],
      "Resource": [
        "acs:oss:*:*:obs-agent"
      ],
      "Condition": {
        "StringLike": {
          "oss:Prefix": [
            "reading/preview/*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "oss:GetObject",
        "oss:PutObject"
      ],
      "Resource": [
        "acs:oss:*:*:obs-agent/reading/preview/obs-notes-hub/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "oss:DeleteObject"
      ],
      "Resource": [
        "acs:oss:*:*:obs-agent/reading/preview/obs-notes-hub/*/blobs/*",
        "acs:oss:*:*:obs-agent/reading/preview/obs-notes-hub/*/manifests/*"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "oss:DeleteObject",
        "oss:DeleteObjectVersion"
      ],
      "Resource": [
        "acs:oss:*:*:obs-agent/reading/preview/obs-notes-hub/*/commits/*"
      ]
    }
  ]
}
